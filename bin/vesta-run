#!/bin/sh
# Run Vesta however it happens to be installed here.
#
# A slash command must produce Vesta's answer or a sentence saying why not.
# What it must never produce is a Python traceback or a shell error: the user
# asked what their repository does and got a stack, which reads as a broken
# tool rather than a missing install.
set -u

here=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if command -v vesta >/dev/null 2>&1; then
    exec vesta "$@"
fi

python=$("$here/vesta-python" 2>/dev/null) || python=""
if [ -n "$python" ]; then
    exec "$python" -m vesta.cli "$@"
fi

echo "Vesta is installed as a plugin but no interpreter here can run it."
echo
echo "  pip install vesta"
echo "     or"
echo "  export VESTA_PYTHON=/path/to/a/python/that/has/vesta"
echo
echo "Then reopen this session."
exit 0
