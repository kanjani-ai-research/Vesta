#!/bin/sh
# Run Vesta however it happens to be installed here.
#
# A slash command must produce Vesta's answer or a sentence saying why not.
# What it must never produce is a Python traceback or a shell error: the user
# asked what their repository does and got a stack, which reads as a broken
# tool rather than a missing install.
set -u

here=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if command -v vesta >/dev/null 2>&1; then
    exec vesta "$@"
fi

python=$("$here/vesta-python" 2>/dev/null) || python=""
if [ -n "$python" ]; then
    exec "$python" -m vesta.cli "$@"
fi

# Nothing reached, and building one did not work either. The likeliest reason
# by far is the Python version: macOS ships 3.9, `mcp` publishes for 3.10 and
# up, so a machine with only the system Python cannot run the sidecar. Say that
# rather than "not installed", which sends people looking in the wrong place.
echo "Vesta could not start."
echo
echo "It builds its own environment on first use and needs Python 3.10 or"
echo "newer to do it. macOS ships 3.9, which is not enough: the mcp package"
echo "does not publish for it."
echo
echo "  brew install python@3.13"
echo
echo "Then reopen this session. Nothing else is needed; Vesta installs itself."
exit 0
