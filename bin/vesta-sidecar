#!/bin/sh
# Start the MCP server with whatever interpreter actually has Vesta.
#
# A server that cannot start does not fail loudly — it is simply absent, and
# every tool goes missing with nothing said about why. So the reason is written
# to stderr, where the host records it, rather than dying silently.
set -u

here=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

python=$("$here/vesta-python" 2>/dev/null) || python=""
if [ -n "$python" ]; then
    exec "$python" -m vesta.sidecar "$@"
fi

echo "vesta: no interpreter on this machine can run vesta.sidecar." >&2
echo "vesta: pip install vesta, or set VESTA_PYTHON to one that has it." >&2
exit 1
