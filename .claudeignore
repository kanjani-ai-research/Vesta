# A virtualenv does not survive being copied: `bin/python` is a symlink to the
# interpreter it was built from, so the directory arrives with a dead link in
# it. Shipping it means every entry point probes a path that exists and cannot
# run — which is exactly what printed `python: command not found` above every
# prompt in a session.
.venv/
venv/

# Not part of what the plugin does.
tests/
doc/
var/
.pytest_cache/
*.egg-info/
__pycache__/
